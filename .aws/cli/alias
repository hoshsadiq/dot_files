[toplevel]
kubeconfig =
  !f() {
    profile="$(
      aws configure list |
       awk -F: '
         /^[[:space:]]*profile[[:space:]]+/ {
           v=$2
           gsub(/<not set>/, "not-set", v)
           gsub(/[[:space:]]+/, "", v)
           print v
         }
       '
    )"

    if [[ $profile == "<not-set>" ]]; then
      printf 'no profile detected, please make sure you use this with `AWS_PROFILE` environment variable instead of the `--profile` argument\n'
      exit 1
    fi

    if [ -z "$1" ]; then
      # Populate "$@" with cluster names without the -eks-cluster suffix
      set -- $(
        aws eks list-clusters --output text --query 'clusters[]' \
          | tr '	' '\n' \
          | sed 's/-eks-cluster$//'
      )

      if [ "$#" -gt 0 ]; then
        printf 'First argument must be eks cluster name. Valid options are:\n' >&2
        printf ' - %s\n' "$@" >&2
      else
        printf 'First argument must be eks cluster name, but no clusters were found.\n' >&2
      fi

      exit 1
    fi

    suffix="-eks-cluster"
    name="${1%"$suffix"}"
    cluster="${name}${suffix}"
    alias="$(awk<<<"$profile" -v name="$name" -F_ '{printf "%s/%s/%s", $1, $2, name}')"

    aws eks update-kubeconfig --name "$cluster" --alias "$alias"
  }; f "$@"

