#!/usr/bin/env bash

set -euo pipefail

# todo some of these functions should go into a separate script and mounted instead of output as a script.
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

run_usage() {
  if [[ " $* " != *" -h "* ]] && [[ " $* " != *" --help "* ]]; then
    return
  fi

  cat <<EOF
usage: $0 [options] image
  options:
    --engine    Forces the container engine.
                Valid values are podman or docker.
                Defaults to binary detection with podman taking precedence.

All docker run and podman run options are permitted.

example:
  shit alpine:3.14
  shit -u$USER alpine:3.14
EOF

  exit 0
}

log() {
  printf >&2 "\e[33m%s: $2\e[m\n" "$1" "${@:3}"
}

info() {
  log INFO "$@"
}

warn() {
  log WARNING "$@"
}

err() {
  log ERROR "$@"
}

# todo maybe utilise: https://github.com/LEI/porcelain/blob/master/porcelain.sh
cleanup_bash_history() {
  bashHistDir="$1"
  localBashHistoryFile="$2"
  if [[ -s $localBashHistoryFile ]]; then
    info "Remember, your container's bash_history is at '%s'" "$localBashHistoryFile"
  else
    warn "The container's bash_history is empty, removing..."
  fi
  find "$bashHistDir" -type f -mtime +14 -or -size 0 -exec rm -f {} +
}

shit() {
  local user args container engine dind

  user=""
  container=""
  engine=""
  other_cid=""
  dind=""

  if [[ -z $engine ]]; then
    if command -v podman >/dev/null; then
      engine="podman"
    elif command -v docker >/dev/null; then
      engine="docker"
    else
      err "could not determine a container engine, no podman or docker binary found."
      exit 1
    fi
  fi

  declare -a args=()
  declare -a cmd=()
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case $arg in
    --entrypoint=*)
      cmd+=("${arg#*=}")
      shift
      ;;
    --entrypoint)
      cmd+=("$2")
      shift
      shift
      ;;
    --engine=*)
      engine="${arg#*=}"
      shift
      ;;
    --engine)
      engine="$2"
      shift
      shift
      ;;
    --nsenter=*)
      other_cid="${arg#*=}"
      shift
      ;;
    --nsenter)
      other_cid="$2"
      shift
      shift
      ;;
    -dind)
      dind=true
      shift
      ;;
    -u=* | --user=*)
      user="${arg#*=}"
      shift
      ;;
    -u | --user)
      user="$2"
      shift
      shift
      ;;
    -u*)
      user="${arg:2}"
      shift
      ;;
    --rm | --tty | -t | -P | --publish-all | -d | --detach | --help | --init | --no-healthcheck | --oom-kill-disable | --privileged | --sig-proxy)
      args+=("$arg")
      shift
      ;;
    *)
      if [[ $arg == -- ]]; then
        shift
        cmd+=("$@")
        break
      elif [[ $arg =~ ^(-[a-zA-Z]|--[a-zA-Z\-]+)= ]]; then
        args+=("$arg")
        shift
      elif [[ $arg =~ ^(-[a-zA-Z]|--[a-zA-Z\-]+)$ ]]; then
        args+=("$arg" "$2")
        shift
        shift
      elif [[ -z $container ]]; then
        container="$arg"
        shift
      else
        warn "Found an unmatched argument '%s', will continue, but something probably went wrong with parsing docker/podman args\n" "$arg"
        args+=("$arg")
        shift
      fi
      ;;
    esac
  done

  if [[ -n $other_cid ]]; then
    args+=(
      --privileged
      --security-opt=label=disable
      "--pid=container:$other_cid"
      "--net=container:$other_cid"
      "--ipc=container:$other_cid"
      "--uts=container:$other_cid"
      "--cap-add=SYS_ADMIN"
      "--cap-add=SYS_PTRACE"
      "--cap-add=SYS_CHROOT"
    )
  else
    args+=(--init)
  fi

  if [[ $dind == true ]]; then
    [[ $engine == "docker" ]] && warn "TODO: -dind needs docker support" && exit 1
    local socket
    socket="$(systemctl --user show podman.socket --value --property=Listen | sed 's/ (Stream)$//')"
    args=(--security-opt label:type:container_runtime_t --volume "$socket:/var/run/docker.sock:Z" "${args[@]}")
  fi

  if [[ $user == "" ]]; then
    local format

    format=".User"
    if [[ $engine == "docker" ]]; then
      format=".ContainerConfig$format"
    fi

    user="$("$engine" image inspect --format="{{ $format }}" "$container" || true)"
  fi
  user="${user:-root}"

  if [[ $user =~ ^[a-z_]([a-z0-9_-]{0,31}|[a-z0-9_-]{0,30}\$): ]]; then
    user="${user//:*/}"
    warn "Unable to deal with user:group notation, taking user only: %s" "$user"
  fi

  bashHistDir="$HOME/tmp/container-bash"
  command mkdir -p "$bashHistDir"
  localBashHistoryFile="$(mktemp -p "$bashHistDir" -t "${container//[:\/]/}.XXXXXXXX.bash_history")"
  trap 'cleanup_bash_history "$bashHistDir" "$localBashHistoryFile"' EXIT
  command chmod 777 "$localBashHistoryFile"
  remoteBashHistoryFile="$(mktemp -t 'XXXXXXXX.bash_history' --dry-run)"

  if [[ -z "${args[*]}" ]]; then
    info "Running %s container '%s'" "$engine" "$container"
  else
    info "Running %s container '%s' with args '%s'" "$engine" "$container" "${args[*]}"
  fi
  info "The container's bash_history is at '%s'" "$localBashHistoryFile"
  "$engine" run --interactive \
      --tty \
      --rm \
      --entrypoint /bin/sh \
      --volume "$SCRIPT_DIR/../resources/shit:/etc/shit:z,ro" \
      --volume "$localBashHistoryFile:$remoteBashHistoryFile" \
      --volume "$PWD:$PWD:z" \
      --mount type=volume,source=apt-lists-cache,target=/var/lib/apt/lists \
      --mount type=volume,source=apt-cache,target=/var/cache/apt \
      --mount type=volume,source=apk-cache,target=/var/cache/apk \
      --mount type=volume,source=yum-cache,target=/var/cache/yum \
      --mount type=volume,source=dnf-cache,target=/var/cache/dnf \
      --env SHIT_REAL_USERNAME="$USER" \
      --env SHIT_DOCKER_USER="$user" \
      --env SHIT_USER_UID="$(id -u)" \
      --env SHIT_USER_GID="$(id -g)" \
      --user root \
      --workdir "$PWD" \
      "${args[@]}" \
      "$container" \
      -c 'exec /etc/shit/init.sh "$@"' _ ${cmd[@]+"${cmd[@]}"}

  # todo add cron to clean up bash histories
}

run_usage "$@"
shit "$@"
