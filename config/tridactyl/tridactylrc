" vim: filetype=vim

" This is all copied/stolen from others. Some of those URLs are:
"  - https://github.com/glacambre/.dotfiles/blob/master/default/.config/tridactyl/tridactylrc
"  -

" This wipes all existing settings. This means that if a setting in this file
" is removed, then it will return to default. In other words, this file serves
" as an enforced single point of truth for Tridactyl's configuration.
sanitize tridactyllocal tridactylsync

" auto requires beta version of tridactyl.
set theme auto

" Ctrl-F should use the browser's native 'find' functionality.
unbind <C-f>

" But also support Tridactyl search too.
bind / fillcmdline find
bind ? fillcmdline find -?
bind n findnext 1
bind N findnext -1
" Remove search highlighting.
bind ,<Space> nohlsearch
" Use sensitive case. Smart case would be nice here, but it doesn't work.
set findcase smart

" Smooth scrolling, yes please. This is still a bit janky in Tridactyl.
set smoothscroll true

" Don't run Tridactyl on some web sites because it doesn't work well, or
" because the web site has its own keybindings.
blacklistadd docs\.google\.com/.*/edit.*
blacklistadd ilocz16280190\.salocs\.com

unbindurl mail\.google\.com j
unbindurl mail\.google\.com k
unbindurl mail\.google\.com o
unbindurl mail\.google\.com x
unbindurl mail\.google\.com e

unbindurl mail\.protonmail\.com x
unbindurl mail\.protonmail\.com a
" unbindurl mail\.protonmail\.com t " For now we can use C-v t

" Sometimes the status bar in the bottom left corner overlaps the Tridactyl
" command line, so set an option to move the status bar to the right.
guiset_quiet hoverlink right

" Comment toggler for Reddit, Hacker News and Lobste.rs
bind ;c hint -Jc [class*="expand"],[class="togg"],[class="comment_folder"]
bind ;u hint -Jc [class*="arrow"]

" Make gu take you back to subreddit from comments
bindurl reddit\.com gu urlparent 4

" Google hinting
bindurl www\.google\.com f hint -Jc .rc > .r > a
bindurl www\.google\.com F hint -Jtc .rc > .r > a
bindurl www\.google\.com gF hint -Jqbc .rc > .r > a

" DuckDuckGo hinting
bindurl duckduckgo\.com / focusinput 2
bindurl duckduckgo\.com f hint -Jc .result__a,.result__url__domain
bindurl duckduckgo\.com F hint -Jtc .result__a,.result__url__domain
bindurl duckduckgo\.com gF hint -Jqbc .result__a,.result__url__domain

" Hacker News hinting
bindurl news\.ycombinator\.com f hint -Jc span.pagetop > a,td.title > a,td.subtext > a:last-of-type
bindurl news\.ycombinator\.com F hint -Jtc span.pagetop > a,td.title > a,td.subtext > a:last-of-type
bindurl news\.ycombinator\.com gF hint -Jqbc span.pagetop > a,td.title > a,td.subtext > a:last-of-type

bindurl news\.ycombinator\.com/item f hint -Jc span.pagetop > a,a.storylink,a.hnuser,div.comment a
bindurl news\.ycombinator\.com/item F hint -Jtc span.pagetop > a,a.storylink,a.hnuser,div.comment a
bindurl news\.ycombinator\.com/item gF hint -Jqbc span.pagetop > a,a.storylink,a.hnuser,div.comment a

bindurl github\.com / focusinput 0

" Reddit hinting
" bindurl www.reddit.com f hint -Jc a[data-click-id="subreddit"],a[data-click-id="body"],a.styled-outbound-link
" bindurl www.reddit.com F hint -Jtc a[data-click-id="subreddit"],a[data-click-id="body"],a.styled-outbound-link
" bindurl www.reddit.com F hint -Jqbc a[data-click-id="subreddit"],a[data-click-id="body"],a.styled-outbound-link

" Old reddit hinting
bindurl reddit\.com f hint -Jc a[data-event-action="title"],a.subreddit,span.user > a,a.comments,div[id="srDropdownContainer"] > a,tr > td > a,ul.tabmenu > li > a,div.dropdown,div.drop-choices > form > a
bindurl reddit\.com F hint -Jtc a[data-event-action="title"],a.subreddit,span.user > a,a.comments,div.md > p > a,span.redditname > a,ul.tabmenu > li > a
bindurl reddit\.com gF hint -Jqbc a[data-event-action="title"],a.subreddit,span.user > a,a.comments,div.md > p > a,span.redditname > a,ul.tabmenu > li > a

bindurl reddit\.com\/r\/.*\/comments f hint -Jc a
bindurl reddit\.com\/r\/.*\/comments F hint -Jtc a
bindurl reddit\.com\/r\/.*\/comments gF hint -Jqbc a

" Some AWS magic
bindurl ^https://signin.aws.amazon.com/saml f hint -Jc [class=saml-role]

command aws-sso jsb -p args => {
    const org = args[0];
    if (!org) {
        tri.excmds.fillcmdline_tmp("echo", "Usage: :aws-sso <org>");
        return;
    }
    tri.excmds.tabopen(`https://${org}.awsapps.com/start`);
}

" GitHub pull request add upstream command to clipboard
" bind gys composite js (() => { var items = document.querySelector('.user-select-contain.head-ref a').querySelectorAll('.css-truncate-target'); return "git remote add "+items[0].textContent+" git@github.com:"+items[0].textContent+"/"+items[1].textContent+".git\ngit fetch " + items[0].textContent; })() | yank

" GitHub pull request checkout command to clipboard (only works if you're a collaborator or above)
bind yp composite js document.getElementById("clone-help-step-1").textContent.replace("git checkout -b", "git checkout -B").replace("git pull ", "git fetch ") + "\ngit reset --hard " + document.getElementById("clone-help-step-1").textContent.split(" ")[3].replace("-","/") | yank

" Git{Hub,Lab} git clone via SSH yank
bind yg composite js "git clone " + document.location.href.replace(/https?:\/\//,"git@").replace("/",":").replaceAll(/(:[^\/]+\/[^\/]+).*/g, "$1").replace(/$/,".git") | clipboard yank

" Old reddit if not logged in.
autocmd DocLoad ^http(s?)://www.reddit.com js if (document.getElementById("SearchDropdown")) tri.excmds.urlmodify("-t", "www", "old")

" As above but execute it and open terminal in folder
" bind ,g js let uri = document.location.href.replace(/https?:\/\//,"git@").replace("/",":").replace(/$/,".git"); tri.native.run("cd ~/tmp/projects; git clone " + uri + "; cd \"$(basename \"" + uri + "\" .git)\"; st")

" The default jump of 10 is a bit much.
bind j scrollline 5
bind k scrollline -5

" K and J should move between tabs. Invert them from the default for Sideberry
bind K tabprev
bind J tabnext

" Disable <C-q>
bind --mode=insert <C-q> js alert("<C-q> is for quitters.")
bind --mode=input  <C-q> js alert("<C-q> is for quitters.")
bind --mode=normal <C-q> js alert("<C-q> is for quitters.")
bind --mode=ex     <C-q> js alert("<C-q> is for quitters.")
bind --mode=hint   <C-q> js alert("<C-q> is for quitters.")

" make D take you to the left
bind D composite tabprev; tabclose
bind d tabclose

" make t open the selection with tabopen
bind --mode=visual t composite js document.getSelection().toString() | fillcmdline tabopen

" Allow Ctrl-a to select all in the commandline
unbind --mode=ex <C-a>

" Allow Ctrl-c to copy in the commandline
unbind --mode=ex <C-c>

" Easier keys to navigate up and down
bind --mode=ex <Tab> ex.next_completion
bind --mode=ex <S-Tab> ex.prev_completion
bind --mode=ex <C-j> ex.next_completion
bind --mode=ex <C-k> ex.prev_completion

" Handy multiwindow/multitasking binds
bind gd tabdetach
bind gD composite tabduplicate; tabdetach

" Make yy use canonical / short links on the 5 websites that support them
bind yy clipboard yankcanon

" Stupid workaround to let hint -; be used with composite which steals semi-colons
command hint_focus hint -;

" Open right click menu on links
bind ;C composite hint_focus; !s xdotool key Menu

"
" Misc settings
"

" set editorcmd to suckless terminal, or use the defaults on other platforms
js tri.browserBg.runtime.getPlatformInfo().then(os=>{const editorcmd = os.os=="linux" ? "st vim" : "auto"; tri.config.set("editorcmd", editorcmd)})

" Sane hinting mode
" set hintfiltermode vimperator-reflow
" set hintnames numeric

" Defaults to 300ms but I'm a 'move fast and close the wrong tabs' kinda chap
set hintdelay 100

" Make quickmarks for the sane Tridactyl issue view
quickmark t https://github.com/tridactyl/tridactyl/issues?utf8=%E2%9C%93&q=sort%3Aupdated-desc+

" New reddit is bad
" autocmd DocStart ^http(s?)://www.reddit.com js tri.excmds.urlmodify("-t", "www", "old")
" Mosquito nets won't make themselves
" autocmd DocStart ^http(s?)://www.amazon.co.uk js tri.excmds.urlmodify("-t", "www", "smile")

" Prevent tabs from stealing focus
" autocmd TabEnter .* unfocus

" For syntax highlighting see https://github.com/tridactyl/vim-tridactyl
" vim: set filetype=tridactyl
