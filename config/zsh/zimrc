# Additional completion definitions for Zsh.
zmodule zsh-users/zsh-completions --name zsh-users-completions --fpath src
zmodule zchee/zsh-completions --name zchee-completions --fpath src/zsh
# Enables and configures smart and extensive tab completion.
# completion must be sourced after all modules that add completion definitions.
zmodule completion

# enhancd calls compdef, which needs to be loaded, and it is loaded as part of completion package above
# enhancd writes outside Cursor sandboxes and breaks cd; disable when cursor-agent sets up the env
zmodule babarot/enhancd --if '[[ -z "${CURSOR_AGENT:-}" ]]'

