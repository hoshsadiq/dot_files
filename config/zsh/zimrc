zmodule ohmyzsh/ohmyzsh --root plugins/command-not-found
zmodule ohmyzsh/ohmyzsh --root plugins/globalias \
    --source 'globalias.plugin.zsh' \
    --source "$DOT_FILES/config/zsh/plugins/invert-globalias.zsh"

zmodule hlissner/zsh-autopair
zmodule Tarrasch/zsh-functional --source functional.plugin.zsh

# todo on-pull should run make install with a PREFIX for manpages
zmodule tj/git-extras \
  --source etc/git-extras-completion.zsh \
  --on-pull 'mkdir -p prefix && PREFIX=$PWD/prefix make install' \
    --cmd '
export PATH="$PATH:{}/prefix/bin"
export MANPATH="$MANPATH:{}/prefix/share/man"
'
zmodule djui/alias-tips --cmd 'ZSH_PLUGINS_ALIAS_TIPS_TEXT=" 💡 "'

zmodule wfxr/forgit --fpath completions --source forgit.plugin.zsh --cmd '
alias gds="gd --staged"
export PATH="$PATH:{}/bin"
'

zmodule marlonrichert/zsh-autocomplete

if (( ${+commands[atuin]} )); then
  zmodule atuin-init --use mkdir --if-command atuin \
    --cmd 'if [[ ! {}/init.zsh -nt ${commands[atuin]} ]]; then
      atuin init --disable-up-arrow zsh > {}/init.zsh
      zcompile -UR {}/init.zsh
    fi' \
    --source init.zsh
else
  zmodule zdharma-continuum/history-search-multi-word --use degit
fi

